# ========================================================
# ANDHRA AQUA RATES - Environment Configuration Template
# ========================================================

# Frontend Configuration
VITE_API_BASE_URL=/api/v1

# Backend Security & Core Settings
# In production: generate using: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=insecure-development-key-change-in-production-ashp-2026
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,andhraquarates.com,www.andhraquarates.com

# CSRF Trusted Origins (Mandatory for Django 4/5 over HTTPS & cross-domain)
DJANGO_CSRF_TRUSTED_ORIGINS=https://andhraquarates.com,https://www.andhraquarates.com,http://localhost:5173,http://127.0.0.1:5173

# CORS Configuration
FRONTEND_URL=https://andhraquarates.com
CORS_ALLOWED_ORIGINS=https://andhraquarates.com,https://www.andhraquarates.com,http://localhost:5173,http://127.0.0.1:5173

# SSL & Security Headers (Enable when domain has SSL/HTTPS certificate)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Database Configuration (PostgreSQL in production/Docker, SQLite fallback for dev)
DATABASE_URL=postgres://postgres:postgres@db:5432/shrimphub_db
DATABASE_CONN_MAX_AGE=600

# Razorpay Production Keys
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_live_secret_key
RAZORPAY_WEBHOOK_SECRET=your_actual_webhook_secret
RAZORPAY_PLAN_ID=plan_monthly_499

# Subscription Settings
DEFAULT_SUBSCRIPTION_AMOUNT=499.00
DEFAULT_SUBSCRIPTION_CURRENCY=INR
DEFAULT_SUBSCRIPTION_INTERVAL=MONTH

# Market & Pricing Configuration
PRICE_FRESHNESS_HOURS=24

# Logging
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# Email / Notification Provider (Configure SMTP for production emails)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_api_key
DEFAULT_FROM_EMAIL=notifications@andhraquarates.com
