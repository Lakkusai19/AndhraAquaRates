# ========================================================
# Docker Production Environment (.env.docker)
# ========================================================

# Django Settings
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-key-ashp-2026
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web,frontend,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://localhost:80
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://localhost:80

# Database Settings
POSTGRES_DB=andhra_aqua_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123

# Razorpay Configuration (Replace with Live keys in production)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_live_secret_key
RAZORPAY_WEBHOOK_SECRET=your_actual_webhook_secret
RAZORPAY_PLAN_ID=plan_monthly_499

# Subscription & Price Rules
DEFAULT_SUBSCRIPTION_AMOUNT=499.00
DEFAULT_SUBSCRIPTION_CURRENCY=INR
DEFAULT_SUBSCRIPTION_INTERVAL=MONTH
PRICE_FRESHNESS_HOURS=24

# Logging
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
